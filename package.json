{
  "name": "gmail-docs-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for Gmail and Google Docs in Antigravity",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx scripts/auth.ts",
    "auth:status": "tsx scripts/auth.ts status",
    "auth:revoke": "tsx scripts/auth.ts revoke",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "gmail",
    "google-docs",
    "antigravity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@upstash/redis": "^1.41.0",
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
