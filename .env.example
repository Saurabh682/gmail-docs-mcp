# ==============================================================================
# Gmail + Google Docs MCP Server Configuration
# ==============================================================================

# Google Cloud OAuth 2.0 Client Credentials (Desktop App)
# You can provide these directly or place your downloaded client_secret_*.json in project root.
GDM_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GDM_GOOGLE_CLIENT_SECRET=your_client_secret

# Local token storage path (defaults to OS user config directory, e.g., %APPDATA%/gmail-docs-mcp/token.json)
GDM_TOKEN_PATH=token.json

# Optional override for the state directory (where token.json, ledger.json, and audit.jsonl live)
# GDM_STATE_DIR=

# ------------------------------------------------------------------------------
# Safety & Policy Configuration
# ------------------------------------------------------------------------------

# Recipient allowlist: comma-separated list of exact email addresses or domains (@example.com)
# DEFAULT: empty = only the authenticated account's own email address is permitted.
GDM_ALLOWED_RECIPIENTS=your_email@example.com, @trusted-domain.com

# Recipient cap per email (to + cc + bcc combined; default: 5)
GDM_MAX_RECIPIENTS=5

# Rate Limiter: sliding window sending limits
GDM_MAX_SENDS_PER_MINUTE=5
GDM_MAX_SENDS_PER_DAY=50

# Dry-run default: when true, tool calls without an explicit dry_run flag run in dry-run mode
GDM_DEFAULT_DRY_RUN=true

# Master safety switch: when false, send_email will ONLY allow dry_run: true.
# Set to true only when you are ready to allow actual live email delivery.
GDM_ALLOW_LIVE_SEND=false

# Optional Google Doc allowlist (comma-separated Doc IDs). If unset, all Docs accessible by the account are permitted.
GDM_ALLOWED_DOC_IDS=

# Rate Limiter: sliding window document append limits
GDM_MAX_APPEND_PER_MINUTE=10

# Size limits
GDM_MAX_SUBJECT_CHARS=200
GDM_MAX_BODY_CHARS=50000
GDM_MAX_APPEND_CHARS=100000

# Logger verbosity (debug, info, warn, error)
GDM_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Vercel / Cloud Serverless Configuration
# ------------------------------------------------------------------------------

# Pre-shared API Key required in request headers: Authorization: Bearer <GDM_SERVER_API_KEY>
GDM_SERVER_API_KEY=your_secure_server_api_key_here

# Pre-authorized refresh token (generated via "npm run auth" locally, then set in Vercel)
GDM_GOOGLE_REFRESH_TOKEN=

# Authenticated account email (e.g. your_email@gmail.com)
GDM_ACCOUNT_EMAIL=

# Optional Upstash Redis configuration for distributed rate-limiting and token storage across serverless lambdas
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
